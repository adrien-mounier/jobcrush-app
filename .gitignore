node_modules/
dist/
.turbo/
*.log
.env
.env.*
coverage/
.next/
*.tsbuildinfo
data/
# ...but apps/api/data holds SHIPPED corpus + config the API reads at runtime (sample-postings,
# family floors, languages-by-market). Those were tracked before the blanket `data/` rule existed;
# a NEW one added there is silently dropped by `git add -A` and the deploy 500s on ENOENT at read.
# Re-included by name here (a negation cannot reach inside a directory git has already excluded,
# so the directory itself must be un-excluded first). Uploads stay ignored — user content.
!apps/api/data/
apps/api/data/*
!apps/api/data/*.json
!apps/api/data/*.mjs
next-env.d.ts
scripts/s1-smoke-preview.html
test-results/
playwright-report/
qa-results/
qa-uploads/

graphify-out/

# generated by apps/web/prototypes/build-comparison.mjs — rebuild, don't commit
apps/web/prototypes/tailor-comparison.html

# local session/tool state and working artifacts — never tracked (swept in once by a
# git add -A on 2026-08-12, untracked again the same day)
.claude/worktrees/
.tokensave/
.impeccable/
screenshots/
council-report-*.html
council-transcript-*.md
apps/web/.scratch/
apps/web/e2e_debug/
.claude/.qa-gate-GO
