{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cv-factory/contracts/enrichment_proposal.schema.json",
  "title": "Enrichment inbox",
  "description": "Contract 3. Pending strategic enrichment proposals, keyed to the claim graph (cross-offer). See enrichment_proposal.schema.md. Runtime enforcement: _claim_graph/validate_proposal.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proposals"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "claimText", "intendedClass", "interviewNarrative", "source",
        "originOffer", "tags", "state", "createdAt", "decidedAt",
        "targetContextFile", "narrativeAnchor"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "claimText": { "type": "string", "minLength": 1 },
        "intendedClass": { "enum": ["Partially-Supported", "Unsupported-but-Plausible"] },
        "interviewNarrative": { "type": "string", "minLength": 1 },
        "source": { "enum": ["tailor_gap", "enricher_scan"] },
        "originOffer": { "type": ["string", "null"] },
        "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "state": { "enum": ["pending", "approved", "declined"] },
        "createdAt": { "type": "string" },
        "decidedAt": { "type": ["string", "null"] },
        "targetContextFile": { "type": ["string", "null"] },
        "narrativeAnchor": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      },
      "allOf": [
        {
          "$comment": "A decided proposal records when it was decided.",
          "if": { "properties": { "state": { "enum": ["approved", "declined"] } } },
          "then": { "properties": { "decidedAt": { "type": "string", "minLength": 1 } } }
        }
      ]
    }
  }
}
