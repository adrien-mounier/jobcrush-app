{
  "name": "@jobcrush/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --loader ts-node/esm src/main.ts",
    "start": "node dist/main.js",
    "start:qa": "node dist/qa-main.js",
    "test": "vitest run",
    "eval:labeler": "vitest run --config vitest.eval.config.ts familyLabeler",
    "eval:industry-labeler": "vitest run --config vitest.eval.config.ts industryLabeler",
    "eval:bakeoff": "vitest run --config vitest.eval.config.ts modelBakeoff",
    "set-r2-cors": "node scripts/set-r2-cors.mjs",
    "techmap-smoke": "node scripts/techmap-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "@aws-sdk/s3-request-presigner": "^3.1088.0",
    "@fastify/cookie": "^11.1.2",
    "@jobcrush/contracts": "workspace:*",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "^4.0.2",
    "file-type": "^22.0.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
