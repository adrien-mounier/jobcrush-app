# Web (Next.js) image — same workspace pattern as the API Dockerfile.
FROM node:22-slim AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile
# next.config.mjs's rewrites() is resolved at build time (baked into the routes manifest),
# so API_URL must be a build arg, not just a runtime env var.
ARG API_URL
ENV API_URL=$API_URL
RUN pnpm --filter @jobcrush/ui --filter @jobcrush/web build

FROM node:22-slim
WORKDIR /app/apps/web
ENV NODE_ENV=production
ARG BUILD_SHA=dev
ENV BUILD_SHA=$BUILD_SHA
COPY --from=build /app /app
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3000"]
