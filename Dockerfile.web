# Web (Next.js) image — same workspace pattern as the API Dockerfile.
FROM node:22-slim AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile
# next.config.mjs's rewrites() is resolved at build time (baked into the routes manifest),
# so API_URL must be a build arg, not just a runtime env var.
ARG API_URL
ENV API_URL=$API_URL
# @jobcrush/contracts MUST be built here, not just copied. Its package.json points at `dist/`, and
# `**/dist` is in .dockerignore (and gitignored), so the image has the contracts SOURCE and no build
# output — which makes every type imported from it resolve to nothing, turns the web app's own
# inferred parameters into implicit `any`, and fails `next build`'s type check on whichever file tsc
# reaches first. Broke the staging web deploy on 2026-08-12 (two consecutive red pushes, first error
# `jobcard.tsx: Parameter 'f' implicitly has an 'any' type`) the moment the JobCard shape moved into
# the contracts package. Invisible locally, where turbo builds contracts first. Dockerfile (the API
# image) has always listed it for the same reason; this line had not caught up.
RUN pnpm --filter @jobcrush/contracts --filter @jobcrush/ui --filter @jobcrush/web build

FROM node:22-slim
WORKDIR /app/apps/web
ENV NODE_ENV=production
ARG BUILD_SHA=dev
ENV BUILD_SHA=$BUILD_SHA
COPY --from=build /app /app
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3000"]
